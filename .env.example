# Local SQLite Database
DATABASE_URL="file:./dev.db"

# NextAuth / Auth.js Configuration
NEXTAUTH_URL="http://localhost:3456"
NEXTAUTH_SECRET="gauthmath-super-secret-nextauth-key-2026"
ACCOUNT_ADMISSION_MODE="invitation-only"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Pluggable AI Provider ("auto" | "copilot" | "azure-openai" | "symbolic")
AI_PROVIDER="auto"
COPILOT_MODEL="gpt-5.6-terra"

# Optional Azure OpenAI Configuration (used when AI_PROVIDER="azure-openai" or configured in "auto" mode)
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT="gpt-6.1-sol"
AZURE_OPENAI_VISION_DEPLOYMENT="gpt-5.6-terra"
AZURE_OPENAI_API_VERSION="2025-04-01-preview"

# Optional server-only Azure Speech (local settings take precedence over ../ReadWise/.env)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
AZURE_SPEECH_VOICE="en-US-AndrewMultilingualNeural"
AZURE_SPEECH_OUTPUT_FORMAT="audio-24khz-96kbitrate-mono-mp3"
