# Production PostgreSQL Database
DATABASE_URL="postgresql://tavi_user:strong_password@db.example.com:5432/tavi?schema=public"

# NextAuth / Auth.js Configuration
NEXTAUTH_URL="https://tavi.example.com"
NEXTAUTH_SECRET="replace-with-32-byte-hex-secret-in-production"
ACCOUNT_ADMISSION_MODE="invitation-only"

# Pluggable AI Provider ("copilot" | "azure-openai" | "auto")
AI_PROVIDER="azure-openai"
COPILOT_MODEL="gpt-5.6-luna"

# Azure OpenAI Production Configuration
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_DEPLOYMENT="gpt-5-mini"
AZURE_OPENAI_API_VERSION="2025-01-01-preview"
