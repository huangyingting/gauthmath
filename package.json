{
  "name": "gauthmath-ai-study-platform",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3456",
    "build": "prisma generate && next build --webpack",
    "start": "next start -p 3456",
    "lint": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "db:generate:postgres": "prisma generate --schema=prisma/schema.postgres.prisma",
    "db:migrate:postgres": "prisma migrate deploy --schema=prisma/schema.postgres.prisma",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "test:unit": "tsx tests/unit-tests.ts",
    "test:e2e": "node tests/verify-all-features.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@github/copilot-sdk": "^1.0.14",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "mathjs": "^15.2.0",
    "next": "^16.4.2",
    "next-auth": "^4.24.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.5",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.48.2",
    "postcss": "^8.4.47",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
